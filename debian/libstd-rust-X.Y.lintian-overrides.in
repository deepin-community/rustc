# "libstd" just seemed too generic
libstd-rust-@RUST_VERSION@ binary: package-name-doesnt-match-sonames
libstd-rust-@RUST_VERSION@ binary: sharedobject-in-library-directory-missing-soname

# Rust doesn't use dev shlib symlinks nor any of the other shlib support stuff
libstd-rust-@RUST_VERSION@ binary: dev-pkg-without-shlib-symlink
libstd-rust-@RUST_VERSION@ binary: shlib-without-versioned-soname
libstd-rust-@RUST_VERSION@ binary: unused-shlib-entry-in-control-file

# Libraries that use libc symbols (libterm, libstd, etc) *are* linked
# to libc.  Lintian gets upset that some Rust libraries don't need
# libc, boo hoo!
libstd-rust-@RUST_VERSION@ binary: library-not-linked-against-libc
