# Test data
rustc-@RUST_VERSION@ source: source-is-missing [src/tools/rust-analyzer/crates/ide/src/syntax_highlighting/test_data/*.html]
rustc-@RUST_VERSION@ source: source-is-missing [tests/rustdoc/notable-trait/doc-notable_trait.*.html]
rustc-@RUST_VERSION@ source: source-is-missing [tests/rustdoc/notable-trait/doc-notable_trait-slice.*.html]
rustc-@RUST_VERSION@ source: source-is-missing [tests/rustdoc/notable-trait/doc-notable_trait-negative.*.html]
rustc-@RUST_VERSION@ source: source-is-missing [tests/rustdoc/notable-trait/spotlight*.html]
rustc-@RUST_VERSION@ source: source-is-missing [tests/rustdoc/decl-trailing-whitespace.declaration.html]
rustc-@RUST_VERSION@ source: source-is-missing [vendor/html5ever-*/data/bench/*.html]
rustc-@RUST_VERSION@ source: source-is-missing [vendor/minifier-*/tests/files/minified_main.js]
rustc-@RUST_VERSION@ source: license-problem-json-evil [vendor/spdx-*/src/text/licenses/JSON]
rustc-@RUST_VERSION@ source: license-problem-php-license [vendor/spdx-*/src/text/licenses/PHP-3.01]
rustc-@RUST_VERSION@ source: license-problem-php-license [vendor/spdx-*/src/text/licenses/PHP-3.0]

# debian policy bug #649530, old and new formats
rustc-@RUST_VERSION@ source: mismatched-override missing-license-paragraph-in-dep5-copyright mpl-2.0+ (*)
rustc-@RUST_VERSION@ source: mismatched-override missing-license-paragraph-in-dep5-copyright debian/copyright mpl-2.0+ (*) [debian/source/lintian-overrides:*]
rustc-@RUST_VERSION@ source: missing-license-paragraph-in-dep5-copyright mpl-2.0+ [debian/copyright:*]
rustc-@RUST_VERSION@ source: missing-license-paragraph-in-dep5-copyright debian/copyright mpl-2.0+ (*)

# lintian is superfluous
rustc-@RUST_VERSION@ source: superfluous-file-pattern debian/copyright * (*)
