From 18a1ae938e855da1afc98c3dcbb2a610520d396f Mon Sep 17 00:00:00 2001
From: liushuyu <liushuyu011@gmail.com>
Date: Mon, 17 Jul 2023 16:36:32 +0800
Subject: [PATCH] Port to libgit2 1.5

---
 libgit2-sys/build.rs       | 4 ++--
 libgit2-sys/libgit2        | 2 +-
 src/diff.rs                | 2 +-
 src/transport.rs           | 2 +-
 tests/add_extensions.rs    | 6 ++----
 tests/get_extensions.rs    | 4 +---
 tests/remove_extensions.rs | 2 +-
 7 files changed, 9 insertions(+), 13 deletions(-)

diff --git a/vendor/libgit2-sys/build.rs b/vendor/libgit2-sys/build.rs
index c050fb3..c20c05a 100644
--- a/vendor/libgit2-sys/build.rs
+++ b/vendor/libgit2-sys/build.rs
@@ -14,7 +14,7 @@ fn main() {
     let try_to_use_system_libgit2 = !vendored && !zlib_ng_compat;
     if try_to_use_system_libgit2 {
         let mut cfg = pkg_config::Config::new();
-        if let Ok(lib) = cfg.range_version("1.6.4".."1.7.0").probe("libgit2") {
+        if let Ok(lib) = cfg.range_version("1.5.1".."1.6.0").probe("libgit2") {
             for include in &lib.include_paths {
                 println!("cargo:root={}", include.display());
             }
@@ -188,7 +188,7 @@ fn main() {
     }
 
     features.push_str("#endif\n");
-    fs::write(include.join("git2_features.h"), features).unwrap();
+    fs::write(include.join("git2/sys/features.h"), features).unwrap();
 
     cfg.compile("git2");
 
diff --git a/tests/add_extensions.rs b/tests/add_extensions.rs
index 7d80b70..fe37e1e 100644
--- a/vendor/git2/tests/add_extensions.rs
+++ b/vendor/git2/tests/add_extensions.rs
@@ -11,11 +11,9 @@ fn test_add_extensions() -> Result<(), Error> {
 
     let extensions = unsafe { get_extensions() }?;
 
-    assert_eq!(extensions.len(), 3);
+    assert_eq!(extensions.len(), 2);
     assert_eq!(extensions.get(0), Some("noop"));
-    // The objectformat extension was added in 1.6
-    assert_eq!(extensions.get(1), Some("objectformat"));
-    assert_eq!(extensions.get(2), Some("custom"));
+    assert_eq!(extensions.get(1), Some("custom"));
 
     Ok(())
 }
diff --git a/tests/get_extensions.rs b/tests/get_extensions.rs
index d8dd55f..ac049c6 100644
--- a/vendor/git2/tests/get_extensions.rs
+++ b/vendor/git2/tests/get_extensions.rs
@@ -7,10 +7,8 @@ use git2::Error;
 fn test_get_extensions() -> Result<(), Error> {
     let extensions = unsafe { get_extensions() }?;
 
-    assert_eq!(extensions.len(), 2);
+    assert_eq!(extensions.len(), 1);
     assert_eq!(extensions.get(0), Some("noop"));
-    // The objectformat extension was added in 1.6
-    assert_eq!(extensions.get(1), Some("objectformat"));
 
     Ok(())
 }
diff --git a/tests/remove_extensions.rs b/tests/remove_extensions.rs
index 5f632a8..366da73 100644
--- a/vendor/git2/tests/remove_extensions.rs
+++ b/vendor/git2/tests/remove_extensions.rs
@@ -6,7 +6,7 @@ use git2::Error;
 #[test]
 fn test_remove_extensions() -> Result<(), Error> {
     unsafe {
-        set_extensions(&["custom", "!ignore", "!noop", "!objectformat", "other"])?;
+        set_extensions(&["custom", "!ignore", "!noop", "other"])?;
     }
 
     let extensions = unsafe { get_extensions() }?;
-- 
2.41.0

