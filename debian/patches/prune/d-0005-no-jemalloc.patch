From: Debian Rust Maintainers <pkg-rust-maintainers@alioth-lists.debian.net>
Date: Sat, 2 Oct 2021 01:08:00 +0100
Subject: d-0005-no-jemalloc

Description: remove jemalloc-sys

Forwarded: not-needed
---
 compiler/rustc/Cargo.toml                         | 6 ------
 src/tools/rust-analyzer/crates/profile/Cargo.toml | 2 --
 2 files changed, 8 deletions(-)

Index: rustc/compiler/rustc/Cargo.toml
===================================================================
--- rustc.orig/compiler/rustc/Cargo.toml
+++ rustc/compiler/rustc/Cargo.toml
@@ -20,14 +20,8 @@ rustc_smir = { path = "../rustc_smir" }
 stable_mir = { path = "../stable_mir" }
 # tidy-alphabetical-end
 
-[dependencies.jemalloc-sys]
-version = "0.5.0"
-optional = true
-features = ['unprefixed_malloc_on_supported_platforms']
-
 [features]
 # tidy-alphabetical-start
-jemalloc = ['dep:jemalloc-sys']
 llvm = ['rustc_driver_impl/llvm']
 max_level_info = ['rustc_driver_impl/max_level_info']
 rustc_use_parallel_compiler = ['rustc_driver_impl/rustc_use_parallel_compiler']
Index: rustc/src/tools/rust-analyzer/crates/profile/Cargo.toml
===================================================================
--- rustc.orig/src/tools/rust-analyzer/crates/profile/Cargo.toml
+++ rustc/src/tools/rust-analyzer/crates/profile/Cargo.toml
@@ -14,7 +14,6 @@ doctest = false
 [dependencies]
 cfg-if = "1.0.0"
 libc.workspace = true
-jemalloc-ctl = { version = "0.5.0", package = "tikv-jemalloc-ctl", optional = true }
 
 [target.'cfg(target_os = "linux")'.dependencies]
 perf-event = "=0.4.7"
@@ -24,7 +23,6 @@ windows-sys = { version = "0.52", featur
 
 [features]
 cpu_profiler = []
-jemalloc = ["jemalloc-ctl"]
 
 # Uncomment to enable for the whole crate graph
 # default = [ "cpu_profiler" ]
