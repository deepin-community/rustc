Description: Remove f16/f128 support on unsupported platforms
Author: Nicholas Bishop <nbishop@nbishop.net>
Origin: upstream, https://github.com/rust-lang/rust/commit/ecf2963baf17cead7c7c57c88eddac8696793dd8.patch
Applied-Upstream: https://github.com/rust-lang/rust/commit/ecf2963baf17cead7c7c57c88eddac8696793dd8
Last-Update: 2024-08-05
---
Index: rustc/library/alloc/Cargo.toml
===================================================================
--- rustc.orig/library/alloc/Cargo.toml
+++ rustc/library/alloc/Cargo.toml
@@ -10,7 +10,10 @@ edition = "2021"
 
 [dependencies]
 core = { path = "../core" }
-compiler_builtins = { version = "0.1.40", features = ['rustc-dep-of-std'] }
+compiler_builtins = { version = "0.1.109", features = ['rustc-dep-of-std'] }
+
+[target.'cfg(not(any(target_arch = "aarch64", target_arch = "x86", target_arch = "x86_64")))'.dependencies]
+compiler_builtins = { version = "0.1.109", features = ["no-f16-f128"] }
 
 [dev-dependencies]
 rand = { version = "0.8.5", default-features = false, features = ["alloc"] }
